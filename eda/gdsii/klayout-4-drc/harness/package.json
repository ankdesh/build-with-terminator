{
  "name": "@klayout/harness-drc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "profile"
  ],
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "link:harness": "node scripts/link-harness.mjs",
    "flow:drc": "node scripts/run-flow.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-base": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-model-native": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-runtime": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-flow-yaml": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-sqlite": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tool-flow": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.5",
    "typescript": "5.8.3"
  }
}
