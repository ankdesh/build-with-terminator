    "steps": [
      {
        "id": "clean_data",
        "title": "Clean Data",
        "stage": "cleanup",
        "function": "function",
        "code": "def function(inputs, parameters, context):\n    df = inputs['data'].copy()\n    return {'cleaned': df}",
        "inputs": [
          "data"
        ],
        "outputs": [
          "cleaned"
        ],
        "parameters_used": null,
        "changes_meaning": false,
        "rationale": "Preserve all rows and measurements, including repeated observations."
      },
      {
        "id": "analyze_data",
        "title": "Analyze Data",
        "stage": "analysis",
        "function": "function",
        "code": "import numpy as np\n\ndef function(inputs, parameters, context):\n    df = inputs['cleaned']\n    quality_threshold = parameters['quality_threshold']\n    wine_type = parameters['wine_type']\n    if wine_type is not None:\n        df = df[df['wine_type'] == wine_type]\n    samples = len(df)\n    mean_quality = df['quality'].mean()\n    threshold_count = (df['quality'] >= quality_threshold).sum()\n    alcohol_distribution, bin_edges = np.histogram(df['alcohol'], bins=np.arange(8.0, 15.5, 0.5))\n    bin_labels = [f'{bin_edges[i]} - {bin_edges[i+1]}' for i in range(len(bin_edges)-1)]\n    alcohol_distribution_df = pd.DataFrame({'bin_label': bin_labels, 'count': alcohol_distribution})\n    groups = sorted(df['wine_type'].unique().tolist())\n    five_numbers = [np.quantile(df.loc[df['wine_type'] == group, 'alcohol'], [0, .25, .5, .75, 1]).tolist() for group in groups]\n    alcohol_by_type = {'option': {'xAxis': {'type': 'category', 'data': groups}, 'yAxis': {'type': 'value', 'name': 'Alcohol (% ABV)'}, 'series': [{'type': 'boxplot', 'data': five_numbers}]}}\n    quality_summary = df.groupby('wine_type').agg(sample_count=('quality', 'size'), mean_quality=('quality', 'mean'), median_alcohol=('alcohol', 'median'), count_at_threshold=('quality', lambda x: (x >= quality_threshold).sum())).reset_index()\n    return {'samples': samples, 'mean_quality': mean_quality, 'threshold_count': threshold_count, 'alcohol_distribution': alcohol_distribution_df, 'alcohol_by_type': alcohol_by_type, 'quality_summary': quality_summary}",
        "inputs": [
          "cleaned"
        ],
        "outputs": [
          "samples",
          "mean_quality",
          "threshold_count",
          "alcohol_distribution",
          "alcohol_by_type",
          "quality_summary"
        ],
        "parameters_used": [
          "quality_threshold"
        ],
        "changes_meaning": false,
        "rationale": "Perform analysis on cleaned data to derive metrics and visualizations."
      },
      {
        "id": "correlation_analysis",
        "title": "Correlation Analysis",
        "stage": "analysis",
        "function": "function",
        "code": "import pandas as pd\nimport numpy as np\n\ndef function(inputs, parameters, context):\n    df = inputs['cleaned']\n    labels = ['alcohol', 'density', 'residual sugar', 'volatile acidity', 'sulphates', 'quality']\n    matrix = df[labels].corr(method='spearman')\n    cells = [[x, y, float(matrix.iloc[y, x])] for y in range(len(labels)) for x in range(len(labels))]  \n    return {'measurement_correlations': {'option': {'xAxis': {'type': 'category', 'data': labels}, 'yAxis': {'type': 'category', 'data': labels}, 'visualMap': {'min': -1, 'max': 1, 'inRange': {'color': ['#245bd7', '#ffffff', '#bd3945']}}, 'series': [{'type': 'heatmap', 'data': cells}]}}} \n",
        "inputs": [
          "cleaned"
        ],
        "outputs": [
          "measurement_correlations"
        ],
        "parameters_used": null,
        "changes_meaning": false,
        "rationale": "Compute Spearman correlations for selected measurements and return as a heatmap."
      }
    ],
